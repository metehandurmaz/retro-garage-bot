# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Pexels is optional. Leave empty to skip the Pexels source.
PEXELS_API_KEY=

# Google Cloud OAuth "Desktop app" client JSON, and the token created by `python -m src.authorize`.
YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
YOUTUBE_TOKEN=secrets/token.json
# Uploads are refused if the token belongs to another channel. Retro Garage:
YOUTUBE_CHANNEL_ID=UCaqXKhMsbLzhuWhsfslZqGQ

# public | unlisted | private
PRIVACY_STATUS=public

# Uploads per day, and uploads per run of the scheduled task.
DAILY_LIMIT=3
VIDEOS_PER_RUN=1

# Background track, only mixed into clips that have no audible sound.
MUSIC_FILE=music/bed.mp3
# Fill only if the track requires attribution, e.g. "Music: Track Name - Artist (YouTube Audio Library)".
MUSIC_CREDIT=

# Clips whose mean volume is below this (dB) count as silent.
SILENCE_DB=-45
MAX_SECONDS=59
MIN_SECONDS=5

# Leave empty to use tools/ffmpeg/bin or PATH.
FFMPEG=
FFPROBE=
